GROQ_API_KEY=
META_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Experimental Feature Flags
ENABLE_ORIGINAL_AI=false

# Server Port (Auto-assigned by Render)
PORT=3000
